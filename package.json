{
    "name": "markdag",
    "version": "0.7.0",
    "description": "Turn Markdown into a DAG diagram",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sunanana/markdag.git"
    },
    "homepage": "https://github.com/sunanana/markdag",
    "type": "module",
    "main": "./dist/markdag.js",
    "module": "./dist/markdag.js",
    "types": "./dist/types/index.d.ts",
    "unpkg": "./dist/markdag.iife.js",
    "jsdelivr": "./dist/markdag.iife.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/markdag.js"
        },
        "./core": {
            "types": "./dist/types/core.d.ts",
            "import": "./dist/core.js"
        },
        "./standalone": {
            "types": "./dist/types/standalone.d.ts",
            "import": "./dist/standalone.js"
        },
        "./style.css": "./dist/style.css",
        "./frontmatter.schema.json": "./dist/frontmatter.schema.json"
    },
    "files": [
        "dist",
        "docs/*.md",
        "docs/examples",
        "THIRD_PARTY_NOTICES.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "vite-node scripts/build.ts && tsc -p tsconfig.build.json",
        "prepack": "npm run build",
        "check": "vite-node scripts/check.ts",
        "test": "vitest --run",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit",
        "spike:layout": "vite-node spike/layout/run-flextree.ts && vite-node spike/layout/run-dagre.ts && vite-node spike/layout/build-index.ts",
        "spike:render": "vite --open /spike/render/plan-b.html",
        "playground": "vite --open /spike/playground/index.html",
        "preview": "vite --open /docs/ignore/preview/index.html",
        "playground:build": "vite-node spike/playground/build.ts"
    },
    "devDependencies": {
        "@dagrejs/dagre": "^3.1.1",
        "@playwright/test": "^1.63.0",
        "@types/d3-hierarchy": "^3.1.7",
        "@types/d3-selection": "^3.0.12",
        "@types/d3-zoom": "^3.0.8",
        "@types/node": "^22.20.4",
        "d3-hierarchy": "^3.1.2",
        "d3-shape": "^3.2.0",
        "monaco-editor": "^0.56.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vite-node": "^6.0.0",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "d3-flextree": "^2.1.2",
        "d3-selection": "^3.0.0",
        "d3-zoom": "^3.0.0",
        "markmap-lib": "^0.18.12",
        "yaml": "^2.9.1"
    }
}
